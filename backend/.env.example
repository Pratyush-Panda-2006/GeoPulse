# GeoPulse Backend Configuration
# ============================

# Server Settings
HOST=127.0.0.1
PORT=8000

# Retrieval Assets
# Using paths relative to the backend directory, or absolute paths.
RETRIEVAL_MODEL_PATH=../models/external/RemoteCLIP-RN50.pt
RETRIEVAL_INDEX_PATH=../models/external/rsicd_remoteclip_rn50.index
RETRIEVAL_METADATA_PATH=../models/external/metadata.json

# Production Archive Assets
ARCHIVE_RETRIEVAL_MODEL_PATH=../models/external/RemoteCLIP-RN50.pt
ARCHIVE_RETRIEVAL_INDEX_PATH=../models/external/geopulse_archive.index
ARCHIVE_RETRIEVAL_METADATA_PATH=../models/external/geopulse_archive_metadata.json

# SNUNet Model Path
SNUNET_MODEL_PATH=../models/snunet/best.pt

# CDSE (Copernicus) Credentials for Sentinel Hub
CDSE_CLIENT_ID=your_id
CDSE_CLIENT_SECRET=your_secret

# NVIDIA API for Nemotron Interpretation
NVIDIA_API_KEY=your_key

# Database
DATABASE_URL=sqlite:///./geopulse.db

# Optional Storage AWS config
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional Context Maps
NASA_FIRMS_MAP_KEY=
